lang = "tr" if os.environ.get("SEENBOARD_LANG", "").lower().startswith("tr") else "en"
data = SETS[lang]
box = "today"


def items():
    out = []
    for i, (title, sub, due, overdue) in enumerate(data[box]):
        out.append({"id": f"{box}-{i}", "title": title, "subtitle": sub, "due": due,
                    "overdue": overdue, "url": "https://example.com/" + box,
                    "labels": [], "links": []})
    if box == "today":
        for rid in (0, 1):
            title, _, due, overdue = data["errands"][rid]
            out.insert(rid, {"id": f"plan-{rid}", "title": title, "subtitle": data["errands-title"],
                             "due": due, "overdue": overdue, "url": "https://example.com/errands",
                             "labels": [], "links": [],
                             "source": {"plugin": "demo", "id": f"errands-{rid}"}})
    return out


for line in sys.stdin:
    if not line.strip():
        continue
    req = json.loads(line)
    method, params = req["method"], req.get("params") or {}
    if method == "describe":
        res = {"name": "demo", "version": "0.2.0", "protocol": 1,
               "actions": ["done", "delete", "move", "reorder", "unstar"],
               "accepts_drop": True, "reminders": False}
    elif method == "configure":
        box = params.get("set", "today")
        res = {}
    elif method == "list":
        res = {"items": items()}
    elif method == "drop":
        res = dict(params["item"])
    elif method == "reminders":
        res = {"reminders": []}
    else:
        res = None
    sys.stdout.write(json.dumps({"id": req["id"], "result": res}) + "\n")
    sys.stdout.flush()
